generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
  /// Course director: read-only, own endpoints under /api/v1/supervisor.
  /// Added by migration 20261024000000_supervisor_role. App versions before
  /// 1.0.9 read an unknown role as STUDENT, so no account gets this role
  /// until an app that knows it is on that person's phone.
  SUPERVISOR
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum PointType {
  EARN
  DEDUCT
}

enum RecitationRating {
  VERY_GOOD
  GOOD
  REPEAT
  DID_NOT_MEMORIZE
  MAQRAA
}

model User {
  id           String         @id @default(uuid())
  username     String         @unique
  passwordHash String         @map("password_hash")
  role         Role
  isActive     Boolean        @default(true) @map("is_active")
  lastLogin    DateTime?      @map("last_login")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")
  fcmToken     String?        @map("fcm_token")
  student      Student?
  instructor   Instructor?
  announcement Announcement[]

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Student {
  id                  String    @id @default(uuid())
  userId              String    @unique @map("user_id")
  fullName            String    @map("full_name")
  fatherName          String    @map("father_name")
  dateOfBirth         DateTime  @map("date_of_birth")
  school              String?
  grade               String?
  address             String?
  phone1              String?   @map("phone_1")
  phone2              String?   @map("phone_2")
  instructorId        String    @map("instructor_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")
  credentialsSentAt   DateTime? @map("credentials_sent_at")
  lastCredentialReset DateTime? @map("last_credential_reset")

  user        User         @relation(fields: [userId], references: [id])
  instructor  Instructor   @relation(fields: [instructorId], references: [id])
  attendance  Attendance[]
  pointsLog   PointsLog[]
  recitations Recitation[]

  @@index([instructorId])
  @@index([deletedAt])
  @@index([fullName])
  @@map("students")
}

model Instructor {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id")
  fullName      String    @map("full_name")
  dateOfBirth   DateTime? @map("date_of_birth")
  specialty     String?
  address       String?
  mobile        String?
  /// A holding pool for frozen students («عزل»), not a real حلقة: its
  /// students are left out of every statistic and every reminder.
  isHoldingPool Boolean   @default(false) @map("is_holding_pool")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user       User                   @relation(fields: [userId], references: [id])
  students   Student[]
  attendance InstructorAttendance[]
  /// Days another حلقة was covered by this instructor, and days this
  /// حلقة was covered by someone else («استلمت هالحلقة اليوم»).
  covering   HalaqaCoverage[]       @relation("CoveringInstructor")
  coveredBy  HalaqaCoverage[]       @relation("CoveredHalaqa")

  @@index([fullName])
  @@map("instructors")
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String           @map("student_id")
  date      DateTime         @db.Date
  status    AttendanceStatus
  /// «غائب بعذر» — only meaningful with status ABSENT (attendance_excused_only_absent_chk).
  /// No deduction, no "call the family" alert, not a miss for the regular count.
  excused   Boolean          @default(false)
  markedBy  String           @map("marked_by")
  notes     String?
  createdAt DateTime         @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, date])
  @@index([date])
  @@index([markedBy])
  @@index([status])
  @@map("attendance")
}

model PointCategory {
  id           String    @id @default(uuid())
  name         String
  nameAr       String?   @map("name_ar")
  type         PointType
  defaultValue Int       @map("default_value")
  hasRating    Boolean   @default(false) @map("has_rating")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")

  pointsLog PointsLog[]

  @@index([isActive])
  @@map("point_categories")
}

model PointsLog {
  id          String            @id @default(uuid())
  studentId   String            @map("student_id")
  categoryId  String            @map("category_id")
  amount      Decimal           @db.Decimal(7, 3)
  rating      RecitationRating?
  description String?
  awardedBy   String            @map("awarded_by")
  sourceId    String?           @map("source_id")
  sourceType  String?           @map("source_type")
  termId      Int?              @map("term_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  student  Student       @relation(fields: [studentId], references: [id])
  category PointCategory @relation(fields: [categoryId], references: [id])
  term     Term?         @relation(fields: [termId], references: [id])

  @@index([studentId])
  @@index([categoryId])
  @@index([studentId, categoryId])
  @@index([createdAt])
  @@index([awardedBy])
  @@index([sourceType, sourceId])
  @@index([termId])
  @@index([studentId, termId])
  @@map("points_log")
}

model PointRule {
  id          String   @id @default(uuid())
  code        String   @unique
  nameAr      String   @map("name_ar")
  description String?
  points      Int
  isPerPage   Boolean  @default(false) @map("is_per_page")
  minPages    Int?     @map("min_pages")
  isAutomatic Boolean  @default(false) @map("is_automatic")
  isDeletable Boolean  @default(false) @map("is_deletable")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("point_rules")
}

model Gift {
  id          String   @id @default(uuid())
  name        String
  description String?
  imageData   String?  @map("image_data") @db.Text
  pointsCost  Int      @map("points_cost")
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isAvailable])
  @@map("gifts")
}

/// A recitation is ALWAYS a verse range: startSurah + startAya + endAya
/// inside one surah, enforced by recitations_verse_range_chk for every row
/// written from 2026-09-05 onwards (rating MAQRAA excepted — see below).
///
/// `surahNumbers` / `isCompleteSura` / `pagesRecited` are legacy columns kept
/// so historical rows stay readable and rendered. Nothing writes the old
/// whole-sura shape any more.
model Recitation {
  id              String           @id @default(uuid())
  studentId       String           @map("student_id")
  instructorId    String           @map("instructor_id")
  surahNumber     Int              @map("surah_number")
  surahNumbers    Int[]            @default([]) @map("surah_numbers")
  pagesRecited    Float            @default(0) @map("pages_recited")
  isCompleteSura  Boolean          @default(false) @map("is_complete_sura")
  rating          RecitationRating
  homework        String?
  date            DateTime         @db.Date
  termId          Int?             @map("term_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  startSurah      Int?
  startAya        Int?
  endSurah        Int?
  endAya          Int?
  startPage       Int?
  endPage         Int?
  pagesCalculated Decimal?         @db.Decimal(5, 3)

  student Student @relation(fields: [studentId], references: [id])
  term    Term?   @relation(fields: [termId], references: [id])

  @@index([studentId])
  @@index([instructorId])
  @@index([date])
  @@index([studentId, date])
  @@index([termId])
  @@map("recitations")
}

model InstructorAttendance {
  id           String   @id @default(uuid())
  instructorId String   @map("instructor_id")
  date         DateTime @db.Date
  present      Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())

  instructor Instructor @relation(fields: [instructorId], references: [id])

  @@unique([instructorId, date])
  @@index([date])
  @@map("instructor_attendance")
}

/// «استلمت هالحلقة اليوم» — one instructor taking responsibility for
/// another حلقة for a single day.
///
/// Who actually recorded a mark is already on the record itself
/// (attendance.markedBy, recitation.instructorId); this table exists so the
/// 9 pm reminder knows who to ask BEFORE anything is recorded, and so the
/// 11 pm summary can name the substitute of a حلقة whose teacher was away.
/// It never moves a student: every student stays in his own حلقة.
///
/// Several substitutes may share one حلقة on one day, so the key is
/// (halaqa, substitute, date).
model HalaqaCoverage {
  id                   String   @id @default(uuid())
  /// The حلقة being covered — the instructor the students belong to.
  halaqaInstructorId   String   @map("halaqa_instructor_id")
  /// The substitute who took it for the day.
  coveringInstructorId String   @map("covering_instructor_id")
  date                 DateTime @db.Date
  note                 String?
  createdAt            DateTime @default(now()) @map("created_at")

  halaqaInstructor   Instructor @relation("CoveredHalaqa", fields: [halaqaInstructorId], references: [id], onDelete: Cascade)
  coveringInstructor Instructor @relation("CoveringInstructor", fields: [coveringInstructorId], references: [id], onDelete: Cascade)

  @@unique([halaqaInstructorId, coveringInstructorId, date], map: "halaqa_coverage_halaqa_covering_date_key")
  @@index([date])
  @@index([coveringInstructorId])
  @@index([halaqaInstructorId, date])
  @@map("halaqa_coverage")
}

/// The evening notifications already handled — the 9 pm «لم تسجّل»
/// reminder, the «غاب جلستين متتاليتين» alert and the 11 pm director
/// summary. One row per (kind, recipient, ref_key) — the row is written
/// BEFORE the push is sent, so a job that runs twice (a restart at 9 pm, two
/// replicas) can never send the same notification twice. It doubles as the
/// log an admin reads to see what went out and whether it was delivered.
///
/// ref_key carries the day for daily kinds («2026-10-31:halaqa:<id>»), and
/// the streak for the absence alert («student:<id>:since:<last attended>»),
/// which is what makes that alert once per break, not once per evening.
model ScheduledNotification {
  id        String   @id @default(uuid())
  /// ATTENDANCE_REMINDER | ABSENCE_ALERT | DIRECTOR_SUMMARY
  kind      String
  userId    String   @map("user_id")
  /// The day the notification is about (for the log), Damascus calendar.
  day       DateTime @db.Date
  refKey    String   @map("ref_key")
  title     String
  body      String
  sent      Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([kind, userId, refKey], map: "scheduled_notifications_kind_user_ref_key")
  @@index([day])
  @@map("scheduled_notifications")
}

model Notification {
  id          String    @id @default(uuid())
  senderId    String    @map("sender_id")
  recipientId String?   @map("recipient_id")
  title       String
  body        String
  type        String
  isBroadcast Boolean   @default(false) @map("is_broadcast")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([recipientId])
  @@index([senderId])
  @@index([createdAt])
  @@index([recipientId, readAt])
  @@map("notifications")
}

model Media {
  id         String   @id @default(uuid())
  uploadedBy String   @map("uploaded_by")
  fileUrl    String   @map("file_url")
  fileType   String   @map("file_type")
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  caption    String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([uploadedBy])
  @@index([targetType, targetId])
  @@map("media")
}

model TempAssignment {
  id                   String    @id @default(uuid())
  studentId            String    @map("student_id")
  originalInstructorId String    @map("original_instructor_id")
  tempInstructorId     String    @map("temp_instructor_id")
  startDate            DateTime  @map("start_date") @db.Date
  endDate              DateTime? @map("end_date") @db.Date
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([studentId])
  @@index([tempInstructorId])
  @@index([originalInstructorId])
  @@index([startDate, endDate])
  @@map("temp_assignments")
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  body        String
  pinned      Boolean   @default(false)
  publishedAt DateTime  @default(now()) @map("published_at")
  expiresAt   DateTime? @map("expires_at")
  createdBy   String    @map("created_by")

  author User @relation(fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([publishedAt])
  @@index([pinned, publishedAt])
  @@map("announcements")
}

// ═══════════════════════════════════════════════════════════════════════════
// TERM ("دورة" / course) — the unit of points isolation.
//
// Every course is completely independent: its own points, its own
// leaderboard, its own statistics. Starting a course copies, resets and
// deletes NOTHING — students and all previous courses stay exactly as they
// are; the new course simply has no points_log rows yet, so every balance in
// it reads 0. Points never move between courses.
//
// Added 2026-06-08. Backfill performed by prisma/seed-terms.ts.
//
// Guarantees that live in the database and cannot be expressed in this file
// (see prisma/migrations/*/migration.sql):
//   • terms_only_one_active_idx        — at most one active course
//   • set_term_id_to_active            — stamps new rows with the active
//                                        course (belt to the application
//                                        layer's braces)
//   • freeze_term_id                   — a row's course is immutable, so
//                                        points can never migrate
//   • *_term_required_chk              — every row written from 2026-09-05
//                                        onwards must carry a course
//   • recitations_verse_range_chk      — every new non-MAQRAA recitation
//                                        must carry a valid single-surah
//                                        verse range
// ═══════════════════════════════════════════════════════════════════════════
model Term {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  nameAr       String    @map("name_ar")
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  isActive     Boolean   @default(false) @map("is_active")
  /// Meeting days as ISO weekdays (Monday = 1 … Sunday = 7, as PostgreSQL
  /// EXTRACT(ISODOW)). Only a REQUIRED day can be missed; an OPTIONAL day —
  /// and any day outside the schedule — counts for a student only if they
  /// attended, and an absence on it is never deducted. Disjoint, enforced by
  /// terms_meeting_days_chk.
  requiredDays Int[]     @default([]) @map("required_days")
  optionalDays Int[]     @default([]) @map("optional_days")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  recitations Recitation[]
  pointsLog   PointsLog[]

  @@index([isActive])
  @@map("terms")
}

// ═══════════════════════════════════════════════════════════════════════════
// NAWAWI 40 HADITH — added 2026-06-23 (additive; DB tables already applied on
// production via direct migration, no SQL file in repo). Scalar-only models:
// FK columns (hadith_number, term_id, student_id, instructor_id) are kept as
// plain scalars — no relation fields — to avoid touching existing models.
// term_id is populated by the DB trigger `set_term_id_to_active` on insert.
// Generate-only: never run `prisma migrate` for these.
// ═══════════════════════════════════════════════════════════════════════════
model HadithPointsRule {
  hadithNumber Int      @id @map("hadith_number")
  basePoints   Int      @map("base_points")
  title        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("hadith_points_rules")
}

model HadithRecitation {
  id            String   @id @default(uuid())
  studentId     String   @map("student_id")
  instructorId  String   @map("instructor_id")
  hadithNumber  Int      @map("hadith_number")
  pointsAwarded Int      @map("points_awarded")
  termId        Int?     @map("term_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([studentId, hadithNumber])
  @@map("hadith_recitations")
}
